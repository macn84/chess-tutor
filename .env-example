# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit the real file.

# Your Chess.com username (used by the My Games tab)
CHESS_COM_USERNAME=your_chess_com_username

# Anthropic API key — enables Claude Haiku coaching insights.
# Leave blank to fall back to engine-only analysis.
ANTHROPIC_API_KEY=

# Set to 1 to include LLM prompt debug info in /api/games/results responses.
# Never enable in production — exposes system prompt and full player data.
DEBUG_LLM_PAYLOADS=
